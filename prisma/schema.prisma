// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}

model Product {
  id          String   @id @map("aw_product_id")
  name        String   @map("product_name")
  slug        String?  @unique
  description String?
  price       Float?   @map("search_price")
  currency    String?
  imageUrl    String?  @map("image_url")
  productUrl  String?  @map("product_url")
  merchant    String?  @map("merchant_name")
  category    String?  @map("category_name")
  
  merchantProductId           String? @map("merchant_product_id")
  merchantCategory            String? @map("merchant_category")
  categoryId                  String? @map("category_id")
  brandName                   String? @map("brand_name")
  colour                      String?
  productModel                String? @map("product_model")
  productType                 String? @map("product_type")
  
  createdAt                   DateTime? @map("loaded_at")
  
  // Cleaned fields for filters (as requested)
  productModelClean     String? @map("product_model_clean")
  colourClean          String? @map("colour_clean")
  sizeStockStatusClean  String? @map("size_stock_status_clean")
  
  isRecliner           String? @map("is_recliner")
  isSofaBed            String? @map("is_sofa_bed")
  baseSku              String? @map("base_sku")
  colourVariantNumber  Int?    @map("colour_variant_number")
  originalPriceClean   Float?  @map("original_price_clean")
  discountedPriceClean Float?  @map("discounted_price_clean")
  saving               Float?
  
  // Missing columns from DB added:

  rawRow               String?   @map("raw_row")
  transformedAt        DateTime? @map("transformed_at")
  salesDiscount        String?   @map("sales_discount")

  // Relations
  categoryRel         Category? @relation(fields: [category], references: [name], onDelete: Restrict, onUpdate: Restrict)
  colourRel           Colour?   @relation(fields: [colourClean], references: [name])
  sizeRel             Size?     @relation(fields: [sizeStockStatusClean], references: [name])
  materialRel         Material? @relation(fields: [productModelClean], references: [name])
  retailerRel         Retailer? @relation(fields: [merchant], references: [name])
  colorVariants       ProductColorVariant[]

  @@map("AWIN_AFFILIAT_PRODUCTS_DATA_PROD")
  @@index([category])
  @@index([name])
  @@index([merchant])
  @@index([colourClean])
  @@index([sizeStockStatusClean])
  @@index([productModelClean])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isAwin    Boolean  @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
}

model Colour {
  id        String   @id @default(cuid())
  name      String   @unique
  products  Product[]
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique
  products  Product[]
}

model Material {
  id        String   @id @default(cuid())
  name      String   @unique
  products  Product[]
}

model Retailer {
  id        String   @id @default(cuid())
  name      String   @unique
  products  Product[]
}


model User {
  id        String   @id @default(uuid())
  type      String   // e.g., "INDIVIDUAL" or "BUSINESS"
  role      String   @default("USER") // "USER", "ADMIN", "DESIGNER"
  isApproved Boolean @default(false)
  isDesigner Boolean @default(false)

  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  appleId   String?  @unique
  address   String?
  phone     String?
  portfolio PortfolioImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model PortfolioImage {
  id        String   @id @default(uuid())
  url       String
  title     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  userId    String
  createdAt DateTime @default(now())
}
model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  content     String   @db.Text
  image       String?
  date        String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductColorVariant {
  id         String  @id @default(cuid())
  awinId     String  @unique @map("awin_id")
  colorName  String  @map("color_name")
  imageUrl   String? @map("image_url")
  productUrl String? @map("product_url")
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
}

model HomepageProduct {
  id        String   @id @default(cuid())
  productId String   @unique @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("homepage_products")
}
